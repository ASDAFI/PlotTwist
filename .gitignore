# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# Portable UI build output
dist-ui/
dataset-studio/backend/.venv/
**/__pycache__/
**/.pytest_cache/
*.tsbuildinfo

# Local runtime state and databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.docker-data/

# Local tool caches
.cache/
.vite/
.turbo/

.plottwist/

# Private/local Dataset Studio inputs and generated outputs.
# Keep the small *_example fixtures committed for demos and tests.
/dataset/
/responses/
/outputs/
/dataset-studio/dataset/
/dataset-studio/responses/
/dataset-studio/outputs/
/dataset-studio/examples/dataset/
/dataset-studio/examples/responses/
/dataset-studio/exports/*
!/dataset-studio/exports/.gitkeep
/exports/*
!/exports/.gitkeep
